# Хуулж ашиглана: cp .env.example .env   (.env-ийг git-д ОРУУЛАХГҮЙ)
POSTGRES_USER=uyaldaa
POSTGRES_PASSWORD=uyaldaa
POSTGRES_DB=uyaldaa
# Docker-гүй ажиллуулахад:
DATABASE_URL=postgresql+psycopg://uyaldaa:uyaldaa@localhost:5432/uyaldaa
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
EMBEDDING_MODEL=sentence-transformers/LaBSE
LINK_THRESHOLD=0.5
DIRECT_THRESHOLD=0.7
HYBRID_LAMBDA=0.7
LLM_ENABLED=false
